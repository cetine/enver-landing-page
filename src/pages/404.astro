---
import Base from '../layouts/Base.astro';
import { t } from '../i18n/routes';
const tr = t('en');
---
<Base title="404" description="Page not found — Enver Cetin">
  <section class="py-24 text-center">
    <h1 class="font-serif text-4xl font-light">404</h1>
    <p class="mt-6 text-muted">{tr('notfound.title')}</p>
    <p class="text-muted">Seite nicht gefunden</p>
    <a href="/" class="mt-8 inline-block underline underline-offset-4 hover:text-fg">{tr('notfound.back')}</a>
  </section>
</Base>
