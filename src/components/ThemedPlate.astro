---
import { Image } from 'astro:assets';
import { workArt, type PlateFormat } from '../data/workArt';
import { getLocaleFromPath, type Locale } from '../i18n/routes';

interface Props {
  industry: string;
  format?: PlateFormat;
  class?: string;
  widths?: number[];
  sizes?: string;
}

const { industry, format = 'standard', class: klass = '', widths, sizes } = Astro.props;

const art = workArt[industry];
if (!art) throw new Error(`ThemedPlate: no work art for industry "${industry}"`);

const set = art.images[format];
const locale: Locale = getLocaleFromPath(Astro.url.pathname.replace(/\/$/, '') || '/');
const alt = art.alt[locale];

// Per-format defaults; callers may override.
const w = widths ?? (format === 'wide' ? [768, 1280, 1920] : [320, 640, 960]);
const s = sizes ?? '100vw';
---
{/*
  Both theme variants are rendered; CSS (global.css) shows exactly one based on
  data-theme. The SSR default is light, so the light variant is visible on first
  paint with no JS — no flash of both, no layout shift when the theme script runs.
*/}
<Image src={set.dark} alt={alt} widths={w} sizes={s} class={`plate--dark ${klass}`} loading="lazy" />
<Image src={set.light} alt={alt} widths={w} sizes={s} class={`plate--light ${klass}`} loading="lazy" />
